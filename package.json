{
  "name": "rapidlink-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "cms:install": "npm --prefix cms/sanity/studio install",
    "cms:dev": "npm --prefix cms/sanity/studio run dev -- --host 127.0.0.1 --port 3333",
    "cms:build": "npm --prefix cms/sanity/studio run build",
    "test:sanity": "npm run build && playwright test --config playwright.sanity.config.js",
    "dev": "vite",
    "start": "node tools/serve-site.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cms-ui": "vitest run --config vitest.cms.config.js",
    "check:deployment": "node tools/check-deployment.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "pdfjs-dist": "^6.5.438",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "supabase": "^3.0.0",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
