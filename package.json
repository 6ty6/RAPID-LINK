{
  "name": "rapidlink-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "cms:install": "npm --prefix server/cms install",
    "cms:dev": "node tools/start-cms-demo.mjs",
    "cms:start": "node --env-file-if-exists=server/cms/.env server/cms/server.mjs",
    "cms:test": "node --test --test-isolation=none server/cms/store.test.mjs server/cms/http.test.mjs",
    "cms:test:e2e": "playwright test --config playwright.cms.config.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "pdfjs-dist": "^6.5.438",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "supabase": "^3.0.0",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
