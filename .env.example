# Public, non-secret configuration only.
VITE_SITE_URL=https://rapidlinkgh.com
# Keep previews out of search. Enable only for an approved production release.
VITE_INDEXABLE=false
# The general loan application portal is not yet verified.
VITE_GENERAL_LOAN_PORTAL_URL=
VITE_ACCOUNT_API_BASE_URL=
# Public Supabase project values. The anon key is safe in the browser only when
# the row-level security policies in supabase/careers.sql are enabled. These
# values unlock the invitation-only news and vacancy content portal.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional test-only users for `npm run test:hosted-api`. Create dedicated
# accounts in Supabase Authentication. Approve only the administrator account
# in public.content_admins. Never commit real passwords.
HOSTED_TEST_ADMIN_EMAIL=
HOSTED_TEST_ADMIN_PASSWORD=
HOSTED_TEST_NON_ADMIN_EMAIL=
HOSTED_TEST_NON_ADMIN_PASSWORD=
