{
  "name": "rapidlink-sanity-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "migrate:calculator-page": "sanity exec scripts/migrateCalculatorPage.js --with-user-token",
    "migrate:calculator-page:dry-run": "node scripts/migrateCalculatorPage.js --dry-run",
    "verify:calculator-page": "sanity exec scripts/verifyCalculatorPage.js --with-user-token",
    "migrate:digital-channels": "sanity exec scripts/migrateDigitalChannels.js --with-user-token",
    "migrate:digital-channels:dry-run": "node scripts/migrateDigitalChannels.js --dry-run",
    "verify:digital-channels": "sanity exec scripts/verifyDigitalChannels.js --with-user-token",
    "dev": "sanity dev",
    "build": "sanity build",
    "deploy": "sanity deploy",
    "migrate:faqs": "sanity exec scripts/migrateFaqs.js --with-user-token",
    "migrate:faqs:dry-run": "sanity exec scripts/migrateFaqs.js --with-user-token -- --dry-run",
    "verify:faqs": "sanity exec scripts/verifyFaqs.js --with-user-token",
    "migrate:announcements": "sanity exec scripts/migrateAnnouncements.js --with-user-token",
    "migrate:announcements:dry-run": "sanity exec scripts/migrateAnnouncements.js --with-user-token -- --dry-run",
    "verify:announcements": "sanity exec scripts/verifyAnnouncements.js --with-user-token",
    "migrate:site-settings": "sanity exec scripts/migrateSiteSettings.js --with-user-token",
    "migrate:site-settings:dry-run": "sanity exec scripts/migrateSiteSettings.js --with-user-token -- --dry-run",
    "verify:site-settings": "sanity exec scripts/verifySiteSettings.js --with-user-token",
    "migrate:loan-calculator": "sanity exec scripts/migrateLoanCalculatorSettings.js --with-user-token",
    "migrate:loan-calculator:dry-run": "sanity exec scripts/migrateLoanCalculatorSettings.js --with-user-token -- --dry-run",
    "verify:loan-calculator": "sanity exec scripts/verifyLoanCalculatorSettings.js --with-user-token",
    "migrate:shared-settings": "sanity exec scripts/migrateSharedSettings.js --with-user-token",
    "migrate:shared-settings:dry-run": "sanity exec scripts/migrateSharedSettings.js --with-user-token -- --dry-run",
    "verify:shared-settings": "sanity exec scripts/verifySharedSettings.js --with-user-token"
  },
  "dependencies": {
    "@sanity/themer": "^0.10.7",
    "react": "^19.2.2",
    "react-dom": "^19.2.2",
    "sanity": "^6.23.0",
    "styled-components": "^6.1.15"
  }
}
